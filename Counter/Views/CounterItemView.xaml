<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.Views.CounterItemView">
    <Border Stroke="DimGray"
        StrokeThickness="2"
        WidthRequest="300" 
        HeightRequest="200">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20" />
        </Border.StrokeShape>
        <Grid BackgroundColor="{Binding Color}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Headers: Name, counter actions -->
                <RowDefinition Height="Auto"/>
                <!-- Counter value -->
                <RowDefinition Height="Auto"/>
                <!-- value actions -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="0,5,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Text="{Binding Name}" 
                       Grid.Column="0"
                       Margin="10,10,0,0"
                       FontSize="14"
                       TextColor="{Binding ContrastingColor}"/>
                <ImageButton Source="{Binding TrashIconUri}"
                             Background="Transparent"
                             HeightRequest="8"
                             WidthRequest="8"
                             Clicked="OnDeleteButtonClicked"
                             Grid.Column="1"
                             Margin="0,3,0,0"/>
                
            </Grid>

            <Label Text="{Binding Value}" 
                   Grid.Row="1" 
                   Margin="5" 
                   HorizontalOptions="Center"
                   FontSize="50"
                   TextColor="{Binding ContrastingColor}"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Text="{Binding SubtractionButtonText}"
                        Clicked="OnSubtractionButtonClicked"
                        Grid.Column="0"
                        Margin="5"/>
                <Button Text="{Binding ResetButtonText}"
                        Clicked="OnResetButtonClicked"
                        Grid.Column="1"
                        Margin="5"/>
                <Button Text="{Binding AdditionButtonText}" 
                        Clicked="OnAdditionButtonClicked"
                        Grid.Column="2"
                        Margin="5"/>
            </Grid>
        </Grid>
    </Border>
</ContentView>
