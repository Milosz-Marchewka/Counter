<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.Views.AllCounters"
             xmlns:models="clr-namespace:Counter.Models"
             xmlns:views="clr-namespace:Counter.Views"
             x:DataType="models:AllCounters"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto, Auto" Margin="10">
            <Label Text="{Binding Title}" 
                   VerticalOptions="Center"
                   Margin="20,0,0,0"
                   FontAttributes="Bold"
                   FontSize="22"/>
            <Button x:Name="CreateCounterButton"
                    Text="{Binding CreateCounterText}"
                    Background="Green"
                    VerticalOptions="Center"
                    Grid.Column="1"
                    Clicked="Add_Clicked" />
            <Button x:Name="ClearCountersButton"
                    Text="{Binding ClearCountersText}"
                    Background="Red"
                    VerticalOptions="Center"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    Clicked="ClearCounters_Clicked" />
        </Grid>

        <CollectionView x:Name="notesCollection"
                ItemsSource="{Binding Counters}"
                Margin="20"
                Grid.Row="1">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                             Span="3"
                             HorizontalItemSpacing="10"
                             VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Counter">
                    <views:CounterItemView/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="{Binding NoCountersText}"
                       HeightRequest="200"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       FontSize="20"
                       TextColor="Gray"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>